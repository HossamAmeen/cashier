# Template for /opt/simple-pos/.env on the server (ADR-0004). Generate secrets on the server with `openssl rand`.
# This example is committed; the real file never is.
IMAGE_TAG=latest
API_PORT=8120
WEB_PORT=8121
STATIC_PATH=/opt/simple-pos/static

POSTGRES_DB=simple_pos
POSTGRES_USER=simple_pos
POSTGRES_PASSWORD=__generate__

APP_ENV=production
PRELAUNCH=true
SECRET_KEY=__generate__
JWT_SIGNING_KEY=__generate__
HEALTH_CHECK_PASSWORD=__generate__
ALLOWED_HOSTS=api.cashier.hossam-ameen.online,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://cashier.hossam-ameen.online
CSRF_TRUSTED_ORIGINS=https://api.cashier.hossam-ameen.online
NUM_PROXIES=1
GUNICORN_WORKERS=2
RATELIMIT_ANON=60/minute
RATELIMIT_USER=300/minute
RATELIMIT_AUTH=30/minute
RATELIMIT_HEALTH=120/minute

VITE_API_BASE_URL=https://api.cashier.hossam-ameen.online
