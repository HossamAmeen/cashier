# Copy to infra/deploy.env (gitignored) and fill in. Never commit the real file.
# Topology: shared Ubuntu 24.04 host, existing nginx + certbot, single environment (no staging).
FRONT_DOMAIN=cashier.example.com        # PWA host (nginx -> 127.0.0.1:8121)
BACKEND_DOMAIN=api.cashier.example.com  # API host (nginx -> 127.0.0.1:8120)
SERVER_IP=203.0.113.10                  # public IPv4 of the server; both hosts need an A record to it
SSH_USER=ubuntu                         # SSH user with passwordless sudo
SSH_PORT=22
SSH_KEY_PATH=~/.ssh/id_ed25519
ACME_EMAIL=you@example.com              # Let's Encrypt account email (certbot)

# UNUSED in the current topology (kept only for reference; leave empty):
# DOMAIN=            # replaced by FRONT_DOMAIN / BACKEND_DOMAIN (owner decision 2026-09-28)
# staging.*          # no staging environment (owner decision 2026-09-28)
# CLOUDFLARE_API_TOKEN=   # DNS is on Namecheap, not Cloudflare
