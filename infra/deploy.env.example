# Copy to infra/deploy.env (gitignored) and fill in. Never commit the real file.
DOMAIN=example.com            # you buy this; agents will use DOMAIN and staging.DOMAIN
SERVER_IP=203.0.113.10        # public IPv4 of your VPS (Ubuntu 24.04, >=2 vCPU / 4 GB)
SSH_USER=root                 # first login user; bootstrap creates a 'deploy' user
SSH_PORT=22
SSH_KEY_PATH=~/.ssh/simple_pos_ed25519
ACME_EMAIL=you@example.com    # for Let's Encrypt certificates (via Caddy)
# Optional: only if your DNS is on Cloudflare (token scope: Zone.DNS:Edit for this zone)
CLOUDFLARE_API_TOKEN=
