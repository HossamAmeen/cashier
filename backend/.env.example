# Copy to backend/.env for local development. Never commit .env (DRF_SKILL §8).
APP_ENV=development
SECRET_KEY=change-me
JWT_SIGNING_KEY=change-me-too
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://pos:pos@localhost:55432/pos
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# JWT (ADR-0011)
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Health API (DRF_SKILL §23)
HEALTH_CHECK_PASSWORD=change-me

# Generic API rate limiting (ADR-0009). BR-AUTH-03 is fixed in code, not here.
RATELIMIT_ANON=60/minute
RATELIMIT_USER=300/minute
RATELIMIT_AUTH=30/minute
RATELIMIT_HEALTH=120/minute
NUM_PROXIES=1

# Server only (ADR-0004): true until GATE C; seed_qa refuses to run otherwise.
PRELAUNCH=false

# Container / gunicorn (ADR-0002)
GUNICORN_WORKERS=2
STATIC_ROOT=/app/staticfiles
LOG_LEVEL=INFO
